# ---------------------------------------------------------------------
# 3. DERIVED ARTIFACTS — genotypes are recoverable from ALL of these
# ---------------------------------------------------------------------
# Normalized / parsed genotype tables
/data/normalized/
/data/processed/
/data/interim/
*.genotypes.parquet
*.genotypes.feather
*.genotypes.arrow
*.genotypes.json
*.genotypes.csv
*.normalized.*

# Analysis runs: the saved-analysis / save-load feature writes here.
# A run bundle contains per-card genotype evidence and IS raw DNA.
/runs/
/data/runs/
/analyses/
/results/
/output/
/out/
/reports/
*.run.json
*.run.json.gz
*.analysis.json
*.analysis.sqlite
*.analysis.db
run_*.json
analysis_*.json

# Ancestry outputs — PCA coordinates and admixture proportions are a
# high-resolution genetic fingerprint, not an anonymous summary.
*.eigenvec
*.eigenval
*.eigenvec.allele
*.Q
*.P
*.pca.json
*.ancestry.json
*.admixture.*

# Polygenic scores, per-variant score contributions, haplogroup calls
*.sscore
*.sscore.vars
*.profile
*.prs.json
*.prs.csv
*.scores.json
*.haplogroup.json
*.pgs.*

# Relatedness / IBD — leaks genotypes of the subject AND their relatives
*.genome
*.king
*.kin0
*.ibd
*.segments
*.grm
*.grm.bin
*.grm.id
*.grm.N.bin

# QC and intermediate stats keyed to a real sample
*.frq
*.hwe
*.het
*.imiss
*.lmiss
*.sexcheck
*.qc.json

# ---------------------------------------------------------------------
# 4. CACHES, LOGS, TEMP — these routinely capture genotypes verbatim
# ---------------------------------------------------------------------
/cache/
/.cache/
/tmp/
/temp/
/scratch/
*.log
*.tmp
*.bak
*.swp
plink.*
*.nosex
*.hh
core.*

# Notebooks: outputs embed data. Commit stripped notebooks only.
*.ipynb_checkpoints/
.ipynb_checkpoints/

# ---------------------------------------------------------------------
# 5. DOWNLOADED REFERENCE DATA (size + license, not privacy)
# ---------------------------------------------------------------------
# References are fetched at build time by the reference fetcher, never
# vendored. They are large, and their licenses differ (some are
# non-commercial and cannot be redistributed from a public repo).
# The pinned manifest + checksums ARE committed.
#
# NOTE: written as `dir/**` + a directory re-include, NOT as `dir/`. Git
# will not re-include a file whose parent directory is excluded, so
# `/data/references/` followed by `!/data/references/manifest.yaml`
# silently fails to track the manifest. Keep this shape.
/data/references/**
!/data/references/**/
!/data/references/manifest.yaml
!/data/references/manifest.lock
!/data/references/**/*.license.txt
!/data/references/**/CHECKSUMS
!/data/references/README.md

/data/reference/
/refs/
/reference/
/panels/
/vendor/tools/

# Third-party binaries pulled in by the fetcher (plink2, beagle, bcftools)
*.exe
*.dll
*.so
*.dylib
*.jar

# ---------------------------------------------------------------------
# 6. EXPLICIT ALLOWLIST — safe, DNA-free files that must stay tracked
# ---------------------------------------------------------------------
# Curated knowledge pack: card definitions and citations that ship with
# the app. Authored content about variants in general — never about any
# individual's genotypes. Allowlisted by extension, so that dropping a
# genomic file in here does not silently make it committable.
!/knowledge/
!/knowledge/**/
!/knowledge/**/*.yaml
!/knowledge/**/*.yml
!/knowledge/**/*.json
!/knowledge/**/*.toml
!/knowledge/**/*.md
!/knowledge/**/*.csv
!/knowledge/**/*.tsv

# Synthetic test fixtures ONLY. See AGENTS.md: fixtures must be generated,
# never produced by subsetting a real person's file.
#
# One level deep, deliberately. `**` un-ignored the entire subtree, which made
# tests/fixtures/synthetic/<anything>/<real export> trackable -- and because the
# guard's allowlist and the sealing test had the same blind spot, every layer
# failed together. The trailing rule re-ignores subdirectories outright.
!/tests/fixtures/synthetic/
!/tests/fixtures/synthetic/*
/tests/fixtures/synthetic/*/

# ---------------------------------------------------------------------
# 7. SECRETS
# ---------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
credentials.json

